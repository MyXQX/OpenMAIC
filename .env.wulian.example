# ============================================================
# 物联智讲 - 最小可用配置示例
#
# 用法：
#   1) 复制本文件为 .env.local
#   2) 在下面任选 1 个 LLM 提供商填好 API Key
#   3) 设置 DEFAULT_MODEL 让服务端调用走该提供商
#   4) （可选）配置 embedding 让 RAG 走语义检索
#   5) pnpm wulian:build-content   # 构建内置语料
#   6) pnpm dev                    # 启动
#   7) 浏览器访问 http://localhost:3000/wulian
# ============================================================

# ---- LLM Provider（任选其一）----

# A. DeepSeek（推荐做演示，国内速度快、便宜）
# DEEPSEEK_API_KEY=xx
# DEFAULT_MODEL=deepseek:deepseek-v4-flash

# B. 通义千问 Qwen（额外赠送 embedding，最适合带 RAG 的物联智讲）
# QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx
# DEFAULT_MODEL=qwen:qwen3.6-flash

# C. 智谱 GLM
# GLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxx
# DEFAULT_MODEL=glm:glm-4.7-flash

# D. OpenAI（境外）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx
# DEFAULT_MODEL=openai:gpt-5.4-mini

# ---- 嵌入模型（可选）----
# 如果不配置，物联智讲将自动降级到「关键词匹配」，演示也能跑。
# 配置任一即可，否则自动嗅探上面 LLM 提供商的 *_API_KEY。
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx
# EMBEDDING_MODEL=text-embedding-v3
